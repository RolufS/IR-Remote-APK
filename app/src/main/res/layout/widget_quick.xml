<?xml version="1.0" encoding="utf-8"?>
<!-- Startbildschirm-Widget (4×1, skalierbar): Name der Fernbedienung, darunter Ein/Aus · − · + · Eingang. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/quick_widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:paddingLeft="8dp"
    android:paddingTop="6dp"
    android:paddingRight="8dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/quick_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:text="@string/app_name"
        android:textColor="#CCECEEF0"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/quick_power"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/quick_power_bg"
                android:contentDescription="@string/tile_power"
                android:scaleType="center"
                android:src="@drawable/ic_quick_power" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/quick_vol_down"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/quick_key_bg"
                android:contentDescription="@string/tile_vol_down"
                android:scaleType="center"
                android:src="@drawable/ic_quick_vol_down" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/quick_vol_up"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/quick_key_bg"
                android:contentDescription="@string/tile_vol_up"
                android:scaleType="center"
                android:src="@drawable/ic_quick_vol_up" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageButton
                android:id="@+id/quick_input"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:background="@drawable/quick_input_bg"
                android:contentDescription="@string/tile_input"
                android:scaleType="center"
                android:src="@drawable/ic_quick_input" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
