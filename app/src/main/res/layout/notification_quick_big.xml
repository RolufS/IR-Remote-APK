<?xml version="1.0" encoding="utf-8"?>
<!-- Aufgezogene Sperrbildschirm-Benachrichtigung: Mini-Fernbedienung im Stil der App (höchstens ~250 dp hoch).
     Reihe 1 Ein/Aus · Stumm · Eingang, Reihe 2 Lautstärke und Programm, darunter das Steuerkreuz mit Zurück und
     Home, ganz unten (wenn erlaubt) „Ganze Fernbedienung“. Fehlende Tasten blendet MiniRemoteViews aus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/quick_widget_bg"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/mini_power"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/quick_power_bg"
                android:layout_gravity="center"
                android:layout_margin="3dp"
                android:scaleType="center"
                android:src="@drawable/ic_quick_power" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/mini_mute"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/quick_key_bg"
                android:layout_gravity="center"
                android:layout_margin="3dp"
                android:scaleType="center"
                android:src="@drawable/ic_quick_mute" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/mini_input"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/quick_input_bg"
                android:layout_gravity="center"
                android:layout_margin="3dp"
                android:scaleType="center"
                android:src="@drawable/ic_quick_input" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/mini_vol_down"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:background="@drawable/quick_rect_key_bg"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_quick_vol_down" />

        <ImageView
            android:id="@+id/mini_vol_up"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:background="@drawable/quick_rect_key_bg"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:scaleType="center"
            android:src="@drawable/ic_quick_vol_up" />

        <TextView
            android:id="@+id/mini_ch_up"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:background="@drawable/quick_rect_key_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="CH ▲"
            android:textColor="#FFECEEF0"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/mini_ch_down"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:background="@drawable/quick_rect_key_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="CH ▼"
            android:textColor="#FFECEEF0"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mini_back"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:background="@drawable/quick_rect_key_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginEnd="6dp"
            android:layout_marginStart="3dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="BACK"
            android:textColor="#FFECEEF0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="1dp" />

                <ImageView
                    android:id="@+id/mini_up"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/quick_rect_key_bg"
                    android:layout_margin="1dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_quick_up" />

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="1dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/mini_left"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/quick_rect_key_bg"
                    android:layout_margin="1dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_quick_left" />

                <TextView
                    android:id="@+id/mini_ok"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/quick_rect_key_bg"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:layout_margin="1dp"
                    android:maxLines="1"
                    android:text="OK"
                    android:textColor="#FFECEEF0"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/mini_right"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/quick_rect_key_bg"
                    android:layout_margin="1dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_quick_right" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="1dp" />

                <ImageView
                    android:id="@+id/mini_down"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/quick_rect_key_bg"
                    android:layout_margin="1dp"
                    android:scaleType="center"
                    android:src="@drawable/ic_quick_down" />

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_margin="1dp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/mini_home"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:background="@drawable/quick_rect_key_bg"
            android:gravity="center"
            android:includeFontPadding="false"
            android:layout_marginEnd="3dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="HOME"
            android:textColor="#FFECEEF0"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mini_full_remote"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:background="@drawable/quick_pill_bg"
        android:contentDescription="@string/lock_full_remote"
        android:gravity="center"
        android:layout_marginEnd="3dp"
        android:layout_marginStart="3dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_quick_remote" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:includeFontPadding="false"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:text="@string/lock_full_remote"
            android:textColor="#FFECEEF0"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
