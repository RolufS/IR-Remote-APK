<?xml version="1.0" encoding="utf-8"?>
<!-- Aufgezogene Sperrbildschirm-Benachrichtigung: Mini-Fernbedienung in zwei Spalten, damit die Tasten hoch bleiben.
     Links Ein/Aus | Stumm, Eingang | Home, Leiser | Lauter, CH ▼ | CH ▲; rechts das Steuerkreuz und darunter Zurück.
     Kein Knopf „Ganze Fernbedienung“ (SystemUI verlangt bei Klicks in eigenen Ansichten immer das Entsperren):
     sie öffnet das Tippen auf die Benachrichtigung selbst (contentIntent).
     dp-Budget (MINI_REMOTE_MAX_HEIGHT_DP = 252): 2 × 3 dp Innenrand + 4 Zeilen × (52 dp + 2 × 2 dp) = 230 dp.
     Fehlende Tasten macht MiniRemoteViews unsichtbar (INVISIBLE), der Platz bleibt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/quick_widget_bg"
android:baselineAligned="false"
    android:orientation="horizontal"
    android:padding="3dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="4dp"
        android:layout_weight="2"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/mini_power"
                    android:layout_width="@dimen/mini_round_key"
                    android:layout_height="@dimen/mini_round_key"
                    android:layout_gravity="center"
                    android:background="@drawable/quick_power_bg"
                    android:scaleType="center"
                    android:src="@drawable/ic_quick_power" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/mini_mute"
                    android:layout_width="@dimen/mini_round_key"
                    android:layout_height="@dimen/mini_round_key"
                    android:layout_gravity="center"
                    android:background="@drawable/quick_key_bg"
                    android:scaleType="center"
                    android:src="@drawable/ic_quick_mute" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/mini_input"
                    android:layout_width="@dimen/mini_round_key"
                    android:layout_height="@dimen/mini_round_key"
                    android:layout_gravity="center"
                    android:background="@drawable/quick_input_bg"
                    android:scaleType="center"
                    android:src="@drawable/ic_quick_input" />
            </FrameLayout>

            <TextView
                android:id="@+id/mini_home"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/mini_home"
                android:textColor="#FFECEEF0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
android:baselineAligned="false"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mini_vol_down"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:scaleType="center"
                android:src="@drawable/ic_quick_vol_down" />

            <ImageView
                android:id="@+id/mini_vol_up"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:scaleType="center"
                android:src="@drawable/ic_quick_vol_up" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mini_ch_down"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/mini_ch_down"
                android:textColor="#FFECEEF0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/mini_ch_up"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/mini_ch_up"
                android:textColor="#FFECEEF0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/mini_up"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:scaleType="center"
                android:src="@drawable/ic_quick_up" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
android:baselineAligned="false"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/mini_left"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:scaleType="center"
                android:src="@drawable/ic_quick_left" />

            <TextView
                android:id="@+id/mini_ok"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/mini_ok"
                android:textColor="#FFECEEF0"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/mini_right"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:scaleType="center"
                android:src="@drawable/ic_quick_right" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
android:baselineAligned="false"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/mini_down"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:scaleType="center"
                android:src="@drawable/ic_quick_down" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
android:baselineAligned="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/mini_back"
                android:layout_width="0dp"
                android:layout_height="@dimen/mini_key_height"
                android:layout_margin="@dimen/mini_key_margin"
                android:layout_weight="1"
                android:background="@drawable/quick_rect_key_bg"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/mini_back"
                android:textColor="#FFECEEF0"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
