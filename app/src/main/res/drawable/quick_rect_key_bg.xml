<?xml version="1.0" encoding="utf-8"?>
<!-- Abgerundete Taste der Mini-Fernbedienung (wie KeyShape der App, Farben aus RemoteColors). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:angle="270"
                android:endColor="#FF383A3F"
                android:startColor="#FF484B51" />
        </shape>
    </item>
</ripple>
